# Google Sheets integration for the Enquire Now form (app/api/enquiry/route.ts),
# via a Google Apps Script Web App bound to the spreadsheet. See the Apps
# Script setup steps provided alongside this file for how to get the URL.

GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_SECRET=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
